---
import fotoCV from "../assets/FotoCVportrait.avif";
import SocialLinks from "./SocialLinks.astro";

interface Props {
	title: string;
	description: string;
	photoAlt: string;
	cvLabel?: string;
	contactDescription?: string;
	ctaText?: string;
	email?: string;
	lang?: "en" | "es";
}

const {
	title,
	description,
	photoAlt,
	cvLabel = "View CV",
	contactDescription,
	ctaText = "Say Hello",
	email = "contact@gonzalofs.com",
	lang = "en",
} = Astro.props;

const [user, domain] = email.split("@");
---

<section class="contact-me-section" id="contact-me-section">
	<h2 class="section-title">{title}</h2>
	<div class="about-card">
		<div class="about-photo-wrapper">
			<div class="photo-glow"></div>
			<div class="photo-ring"></div>
			<div class="photo-inner">
				<img
					src={fotoCV.src}
					alt={photoAlt}
					class="about-photo"
					width={800}
					height={800}
					loading="lazy"
				/>
			</div>
		</div>
		<div class="about-text">
			<p class="about-bio">{description}</p>
			<SocialLinks cvLabel={cvLabel} lang={lang} />
		</div>
	</div>

	{contactDescription && (
		<div class="contact-card">
			<p class="contact-desc">{contactDescription}</p>

			<a
				href="mailto:inquiries@gonzalofs.com"
				class="site-widget-alt"
				tabindex="-1"
				aria-hidden="true">Contact Me</a
			>
			<input
				type="email"
				name="user_email"
				class="site-widget-alt"
				tabindex="-1"
				aria-hidden="true"
				autocomplete="off"
				value=""
			/>
		</div>
	)}

	{ctaText && (
		<div class="contact-cta action-btn" data-pt1={user} data-pt2={domain}>
			{ctaText}
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="40"
				height="40"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="cta-icon"
				><line x1="22" y1="2" x2="11" y2="13"></line><polygon
					points="22 2 15 22 11 13 2 9 22 2"></polygon></svg
			>
		</div>
	)}
</section>

<style>
	.section-title {
		font-size: 2rem;
		margin-bottom: 3rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.section-title::after {
		content: "";
		height: 1px;
		flex-grow: 1;
		background: linear-gradient(90deg, var(--accent), transparent);
	}

	.contact-me-section {
		padding: 6rem 1.5rem;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
		opacity: 0;
		transform: translateY(40px);
		transition:
			opacity 0.8s cubic-bezier(0.2, 1, 0.3, 1),
			transform 0.8s cubic-bezier(0.2, 1, 0.3, 1);
	}

	.contact-me-section.visible {
		opacity: 1;
		transform: translateY(0);
	}

	.about-card {
		display: grid;
		grid-template-columns: 320px 1fr;
		gap: 3rem;
		align-items: center;
		background: #185ddf12;
		border: 1px solid rgba(94, 158, 255, 0.15);
		border-radius:  200px;
		padding: 2rem 3rem 2rem 10px;
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow:
			0 8px 32px rgba(0, 0, 0, 0.3),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
		transition: border-color 0.4s ease;
		margin-bottom: 2rem;
	}

	.about-card:hover {
		border-color: rgba(94, 158, 255, 0.35);
	}

	.about-photo-wrapper {
		position: relative;
		width: 280px;
		height: 280px;
		margin: 0 auto;
	}

	.photo-inner {
		position: relative;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		overflow: hidden;
		z-index: 1;
		border: 4px solid var(--bg-dark);
	}

	.photo-glow {
		position: absolute;
		inset: -20px;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			rgba(94, 158, 255, 0.25) 0%,
			transparent 70%
		);
		filter: blur(20px);
		animation: pulseGlow 4s ease-in-out infinite alternate;
	}

	.photo-ring {
		position: absolute;
		inset: -4px;
		border-radius: 50%;
		background: conic-gradient(
			from 0deg,
			#5e9eff,
			#0044ff,
			#5e9eff,
			#0044ff,
			#5e9eff
		);
		animation: spinRing 8s linear infinite;
	}

	.about-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.about-photo-wrapper:hover .about-photo {
		transform: scale(1.1);
	}

	@keyframes pulseGlow {
		0% {
			opacity: 0.5;
			transform: scale(1);
		}
		100% {
			opacity: 0.8;
			transform: scale(1.1);
		}
	}

	@keyframes spinRing {
		0% {
			transform: rotate(0deg);
		}
		100% {
			transform: rotate(360deg);
		}
	}

	.about-text {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.about-bio {
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--text-muted);
	}

	.contact-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		background: #185ddf12;
		border: 1px solid rgba(94, 158, 255, 0.15);
		border-radius: 0px 200px 200px 200px;
		padding: 4rem 2rem;
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow:
			0 8px 32px rgba(0, 0, 0, 0.3),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
		transition: border-color 0.4s ease;
		max-width: 800px;
		margin: 0 auto;
	}

	.contact-card:hover {
		border-color: rgba(94, 158, 255, 0.35);
	}

	.contact-desc {
		font-size: 1.15rem;
		line-height: 1.7;
		color: var(--text-muted);
		max-width: 610px;
		text-align: center;
	}

	.site-widget-alt {
		position: absolute;
		left: -9999px;
		opacity: 0;
		pointer-events: none;
	}

	.contact-cta {
		position: absolute;
		right: 10px;
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 2.5rem;
		background: var(--accent);
		color: #fff;
		font-weight: 600;
		font-size: 2.1rem;
		border-radius: 100px 100px 0px 100px;
		text-decoration: none;
		border: none;
		outline: none;
		font-family: inherit;
		cursor: pointer;
		transition: all 0.3s ease;
		box-shadow: 0 4px 15px rgba(94, 158, 255, 0.3);
		margin-top: 30px;
	}

	.contact-cta:hover {
		transform: translateY(-5px);
		box-shadow: 0 6px 20px rgba(94, 158, 255, 0.5);
		filter: brightness(1.1);
	}

	.cta-icon {
		transition: transform 0.3s ease;
		transform: translate(-3px, 2px);
	}

	.contact-cta:hover .cta-icon {
		transform: translate(5px, -4px);
	}

	@media (max-width: 900px) {
		.about-card {
			grid-template-columns: 1fr;
			text-align: center;
			padding: 20px;
		}

		.about-photo-wrapper {
			width: 220px;
			height: 220px;
		}

		.about-text .section-title {
			justify-content: center;
		}

		.about-text .section-title::after {
			display: none;
		}
	}
</style>

<script>
	const contactMeSection = document.getElementById("contact-me-section");
	if (contactMeSection) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 },
		);
		observer.observe(contactMeSection);
	}

	// Action button logic
	const actionBtns = document.querySelectorAll(".action-btn");
	actionBtns.forEach((btn) => {
		btn.addEventListener("click", (e) => {
			e.preventDefault();
			const pt1 = btn.getAttribute("data-pt1");
			const pt2 = btn.getAttribute("data-pt2");
			if (pt1 && pt2) {
				window.location.href = `mailto:${pt1}@${pt2}`;
			}
		});
	});
</script>
