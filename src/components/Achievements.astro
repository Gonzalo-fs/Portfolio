---
interface Stat {
	value: string;
	label: string;
}

interface Achievement {
	title: string;
	company: string;
	description: string;
	icon: "users" | "briefcase" | "cpu" | "refresh" | "building" | "award";
}

interface Props {
	title: string;
	stats: Stat[];
	achievements: Achievement[];
}

const { title, stats, achievements } = Astro.props;

const icons: Record<Achievement["icon"], string> = {
	users: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
	briefcase: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>`,
	cpu: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>`,
	refresh: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>`,
	building: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><path d="M9 22v-4h6v4"></path><path d="M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"></path></svg>`,
	award: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"></path></svg>`,
};
---

<section class="content-section" id="achievements-section">
	<h2 class="section-title">{title}</h2>

	<div class="achievements-panel">
		<!-- Headline metrics -->
		<div class="achievements-stats">
			{
				stats.map((stat) => (
					<div class="stat">
						<div class="stat-value">{stat.value}</div>
						<div class="stat-label">{stat.label}</div>
					</div>
				))
			}
		</div>

		<!-- Detailed achievements -->
		<div class="achievements-list">
			{
				achievements.map((achievement) => (
					<article class="achievement-item">
						<div
							class="achievement-icon"
							set:html={icons[achievement.icon]}
						/>
						<div class="achievement-content">
							<span class="achievement-company">
								{achievement.company}
							</span>
							<h3 class="achievement-title">{achievement.title}</h3>
							<p class="achievement-desc">{achievement.description}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.content-section {
		padding: 4rem 1.5rem;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}

	.section-title {
		font-size: 2rem;
		margin-bottom: 3rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.section-title::after {
		content: "";
		height: 1px;
		flex-grow: 1;
		background: linear-gradient(90deg, var(--accent), transparent);
	}

	/* --- Impact panel --- */
	.achievements-panel {
		background: #185ddf12;
		border: 1px solid rgba(94, 158, 255, 0.15);
		border-radius: 16px;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
		overflow: hidden;
	}

	/* --- Headline metrics --- */
	.achievements-stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		border-bottom: 1px solid rgba(94, 158, 255, 0.12);
	}

	.stat {
		padding: 1.5rem 1rem;
		text-align: center;
		border-right: 1px solid rgba(94, 158, 255, 0.1);
	}

	.stat:nth-child(2n) {
		border-right: none;
	}

	.stat:not(:last-child) {
		border-bottom: 1px solid rgba(94, 158, 255, 0.1);
	}

	.stat:last-child {
		grid-column: 1 / -1;
		border-right: none;
	}

	.stat-value {
		font-family: "Anton", sans-serif;
		font-size: 1.9rem;
		color: var(--accent);
		line-height: 1;
		letter-spacing: 1px;
	}

	.stat-label {
		margin-top: 0.55rem;
		font-size: 0.7rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.8px;
		line-height: 1.35;
	}

	@media (min-width: 900px) {
		.achievements-stats {
			grid-template-columns: repeat(5, 1fr);
		}

		.stat {
			padding: 2rem 1.5rem;
			border-right: 1px solid rgba(94, 158, 255, 0.1);
		}

		.stat:nth-child(2n) {
			border-right: 1px solid rgba(94, 158, 255, 0.1);
		}

		.stat:not(:last-child) {
			border-bottom: none;
		}

		.stat:last-child {
			grid-column: auto;
			border-right: none;
		}

		.stat-value {
			font-size: 2.25rem;
		}
	}

	/* --- Achievement list --- */
	.achievements-list {
		display: grid;
		grid-template-columns: 1fr;
	}

	.achievement-item {
		display: flex;
		gap: 1rem;
		padding: 1.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		transition: background 0.3s ease;
	}

	.achievement-item:last-child {
		border-bottom: none;
	}

	.achievement-item:hover {
		background: rgba(94, 158, 255, 0.04);
	}

	.achievement-icon {
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.05);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
		flex-shrink: 0;
		transition:
			color 0.3s ease,
			background 0.3s ease;
	}

	.achievement-item:hover .achievement-icon {
		color: var(--accent);
		background: rgba(94, 158, 255, 0.1);
	}

	.achievement-icon :global(svg) {
		width: 20px;
		height: 20px;
	}

	.achievement-company {
		display: block;
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.8px;
		margin-bottom: 0.35rem;
	}

	.achievement-title {
		font-size: 1.15rem;
		color: var(--text-main);
		margin-bottom: 0.5rem;
		font-weight: normal;
		letter-spacing: 0.5px;
	}

	.achievement-desc {
		font-size: 0.9rem;
		color: var(--text-muted);
		line-height: 1.65;
		margin: 0;
	}

	@media (min-width: 768px) {
		.achievements-list {
			grid-template-columns: repeat(2, 1fr);
		}

		.achievement-item {
			padding: 2rem;
		}

		.achievement-item:nth-child(odd) {
			border-right: 1px solid rgba(255, 255, 255, 0.06);
		}

		.achievement-item:nth-last-child(-n + 2) {
			border-bottom: none;
		}
	}
</style>
