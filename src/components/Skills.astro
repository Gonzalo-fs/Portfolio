---
interface Skill {
	name: string;
	isExpert?: boolean;
}

interface SkillSubcategory {
	title?: string;
	skills: Skill[];
}

interface Props {
	title: string;
	intro: string;
	legendText: string;
	techStackTitle: string;
	techStackDesc: string;
	techStackSubcategories: SkillSubcategory[];
	knowledgeTitle: string;
	knowledgeDesc: string;
	knowledgeSubcategories: SkillSubcategory[];
}

const {
	title,
	intro,
	legendText,
	techStackTitle,
	techStackDesc,
	techStackSubcategories,
	knowledgeTitle,
	knowledgeDesc,
	knowledgeSubcategories
} = Astro.props;
---

<section class="content-section">
	<h2 class="section-title">{title}</h2>
	<p class="skills-intro">
		{intro}
	</p>

	<div class="skills-legend">
		<div class="legend-item">
			<span class="legend-icon">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
			</span>
			<span class="legend-text">{legendText}</span>
		</div>
	</div>

	<div class="skills-grid">
		<!-- Tech Stack -->
		<div class="skills-card tech-stack">
			<div class="card-header">
				<div class="icon-wrapper">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
				</div>
				<h3>{techStackTitle}</h3>
			</div>
			<p class="card-desc">{techStackDesc}</p>
			<div class="subcategories-wrapper">
				{techStackSubcategories.map(subcat => (
					<div class="subcategory">
						{subcat.title && <h4 class="subcategory-title">{subcat.title}</h4>}
						<div class="tags-container">
							{subcat.skills.map(skill => (
								<span class={`tag ${skill.isExpert ? 'expert-tag' : ''}`}>
									{skill.name}
									{skill.isExpert && (
										<svg class="expert-star-small" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
									)}
								</span>
							))}
						</div>
					</div>
				))}
			</div>
		</div>

		<!-- Knowledge -->
		<div class="skills-card knowledge">
			<div class="card-header">
				<div class="icon-wrapper">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
				</div>
				<h3>{knowledgeTitle}</h3>
			</div>
			<p class="card-desc">{knowledgeDesc}</p>
			<div class="subcategories-wrapper">
				{knowledgeSubcategories.map(subcat => (
					<div class="subcategory">
						{subcat.title && <h4 class="subcategory-title">{subcat.title}</h4>}
						<div class="tags-container">
							{subcat.skills.map(skill => (
								<span class={`tag ${skill.isExpert ? 'expert-tag' : ''}`}>
									{skill.name}
									{skill.isExpert && (
										<svg class="expert-star-small" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
									)}
								</span>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.content-section {
		padding: 4rem 1.5rem;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}

	.section-title {
		font-size: 2rem;
		margin-bottom: 2rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.section-title::after {
		content: "";
		height: 1px;
		flex-grow: 1;
		background: linear-gradient(90deg, var(--accent), transparent);
	}

	.skills-intro {
		font-size: 1.1rem;
		color: var(--text-muted);
		max-width: 800px;
		line-height: 1.6;
		margin-bottom: 2rem;
	}

	.skills-legend {
		margin-bottom: 3rem;
		display: flex;
		align-items: center;
	}

	.legend-item {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(94, 158, 255, 0.05);
		border: 1px solid rgba(94, 158, 255, 0.2);
		padding: 0.5rem 1rem;
		border-radius: 8px;
	}

	.legend-icon {
		color: var(--accent);
		display: flex;
		align-items: center;
	}

	.legend-icon svg {
		width: 18px;
		height: 18px;
		filter: drop-shadow(0 0 5px rgba(94, 158, 255, 0.5));
	}

	.legend-text {
		font-size: 0.9rem;
		color: var(--text-main);
	}

	.skills-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	@media (min-width: 768px) {
		.skills-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.skills-card {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(94, 158, 255, 0.1);
		border-radius: 16px;
		padding: 2rem;
		backdrop-filter: blur(10px);
		transition: all 0.3s ease;
		display: flex;
		flex-direction: column;
	}

	.skills-card:hover {
		border-color: rgba(94, 158, 255, 0.3);
		background: rgba(94, 158, 255, 0.03);
		transform: translateY(-5px);
	}

	.card-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.icon-wrapper {
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.05);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
	}

	.icon-wrapper svg {
		width: 20px;
		height: 20px;
	}

	.skills-card h3 {
		font-size: 1.4rem;
		color: var(--text-main);
		margin: 0;
		letter-spacing: 0.5px;
	}

	.card-desc {
		font-size: 0.85rem;
		color: var(--text-muted);
		margin-bottom: 1.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}

	.subcategories-wrapper {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.subcategory-title {
		font-size: 0.95rem;
		color: var(--text-main);
		margin: 0 0 0.8rem 0;
		opacity: 0.9;
		font-weight: 600;
		letter-spacing: 0.5px;
		text-transform: uppercase;
	}

	.tags-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.tag {
		background: rgba(255, 255, 255, 0.05);
		color: var(--text-main);
		font-size: 0.9rem;
		padding: 0.5rem 1rem;
		border-radius: 20px;
		border: 1px solid rgba(255, 255, 255, 0.05);
		transition: all 0.2s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.tag:hover {
		background: rgba(94, 158, 255, 0.1);
		border-color: rgba(94, 158, 255, 0.3);
	}

	.expert-tag {
		border-color: rgba(94, 158, 255, 0.4);
		background: rgba(94, 158, 255, 0.05);
	}

	.expert-tag:hover {
		border-color: var(--accent);
		background: rgba(94, 158, 255, 0.15);
		box-shadow: 0 0 15px rgba(94, 158, 255, 0.2);
	}

	.expert-star-small {
		width: 14px;
		height: 14px;
		color: var(--accent);
		filter: drop-shadow(0 0 3px rgba(94, 158, 255, 0.8));
	}
</style>
