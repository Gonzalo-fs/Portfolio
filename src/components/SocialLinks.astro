---
interface Props {
	cvLabel?: string;
	lang?: "en" | "es";
	email?: string;
}

const {
	cvLabel = "View CV",
	lang = "en",
	email = "contact@gonzalofs.com",
} = Astro.props;

const cvPath = lang === "es" ? "/ES-GonzaloFS.pdf" : "/EN-GonzaloFS.pdf";
const [user, domain] = email.split("@");
---

<div class="social-links">

	<!-- CV View -->
	<a
		href={cvPath}
		target="_blank"
		rel="noopener noreferrer"
		class="social-btn cv-btn"
		id="social-cv"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
			<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
			<polyline points="14 2 14 8 20 8"/>
			<line x1="16" y1="13" x2="8" y2="13"/>
			<line x1="16" y1="17" x2="8" y2="17"/>
			<polyline points="10 9 9 9 8 9"/>
		</svg>
		{cvLabel}
	</a>
	
	<!-- Email -->
	<a
		href="#"
		class="social-btn icon-btn email-btn"
		aria-label="Email"
		id="social-email"
		data-pt1={user}
		data-pt2={domain}
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
			<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
			<polyline points="22,6 12,13 2,6"/>
		</svg>
	</a>

	<!-- LinkedIn -->
	<a
		href="https://www.linkedin.com/in/gonzalo-fs/"
		target="_blank"
		rel="noopener noreferrer"
		class="social-btn icon-btn"
		aria-label="LinkedIn"
		id="social-linkedin"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
			<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
		</svg>
	</a>

	<!-- GitHub -->
	<a
		href="https://github.com/Gonzalo-fs"
		target="_blank"
		rel="noopener noreferrer"
		class="social-btn icon-btn"
		aria-label="GitHub"
		id="social-github"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
			<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
		</svg>
	</a>


</div>

<style>
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.social-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		text-decoration: none;
		border-radius: 12px;
		transition: all 0.25s cubic-bezier(0.2, 1, 0.3, 1);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.3px;
		cursor: pointer;
	}

	/* Icon-only buttons (GitHub, LinkedIn) */
	.icon-btn {
		width: 44px;
		height: 44px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(94, 158, 255, 0.18);
		color: var(--text-muted);
	}

	.icon-btn:hover {
		color: var(--accent);
		background: rgba(94, 158, 255, 0.1);
		border-color: rgba(94, 158, 255, 0.45);
		transform: translateY(-3px);
		box-shadow: 0 6px 20px rgba(94, 158, 255, 0.2);
	}

	/* CV download button */
	.cv-btn {
		padding: 0 1.25rem;
		height: 44px;
		background: rgba(94, 158, 255, 0.1);
		border: 1px solid rgba(94, 158, 255, 0.35);
		color: var(--accent);
	}

	.cv-btn:hover {
		background: rgba(94, 158, 255, 0.2);
		border-color: var(--accent);
		transform: translateY(-3px);
		box-shadow: 0 6px 20px rgba(94, 158, 255, 0.25);
	}

	.cv-btn svg {
		transition: transform 0.25s ease;
	}

	.cv-btn:hover svg {
		transform: scale(1.1);
	}

	@media (max-width: 900px) {

		.social-links{
			justify-content: center;
			/* width: 160px; Width para 2 filas */
			margin: 0 auto;
		}

	}
</style>
