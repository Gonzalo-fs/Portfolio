---
import Layout from "../layouts/Layout.astro";
import BackgroundEffects from "../components/BackgroundEffects.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import AboutSection from "../components/AboutSection.astro";
import Timeline from "../components/Timeline.astro";
import Skills from "../components/Skills.astro";
---

<Layout currentLanguage="en">
	<BackgroundEffects />

	<Hero
		tag="PORTFOLIO 2026 — ALPHA V.0.5"
		title="GONZALO"
		titleSuffix="FS"
		description="Full Stack Web Developer with over 4 years of experience creating scalable digital solutions with clean code and intuitive designs."
	/>

	<Marquee items={["Laravel", "Nuxt.js", "PHP", "Vue.js", "Java", "JQuery", "SQL", "Git", "Docker"]} />

	<AboutSection
		title="ABOUT ME"
		description="I'm a Full Stack Developer who thrives at the intersection of technology and strategy. With 4+ years of experience building scalable web solutions, I've led the AI integration initiative at my company — pioneering SDD (Spec-Driven Development) workflows that transformed how our team ships software. I navigated the acquisition of our company by Visma, adapting quickly to enterprise-scale processes while keeping the agility of a startup mindset. As the Onboarding Manager, I shape how new team members grow into the company. I'm a firm believer in clean code, best practices, and standards — because great software starts with great foundations. Beyond the keyboard, I'm driven by curiosity: puzzles, LEGO, video games, and any challenge that sparks creative thinking. I lead projects, I solve problems, and I get things done."
		highlights={["AI Integration Leader", "Onboarding Manager", "Clean Code Advocate", "Creative Problem Solver", "Team Leader", "Spec-Driven Development", "Standards & Best Practices", "Visma Acquisition Veteran"]}
		photoAlt="Gonzalo Fontana Santibáñez"
	/>

	<Timeline
		title="EXPERIENCE & EDUCATION"
		items={[
			{
				period: "2021 - Present",
				role: "Full-stack Developer & Product Owner",
				company: "tugesto",
				desc: "Onboarding Manager, full-stack programmer, and Product Owner of several projects. API development, web redesign, AI assistant features, automatic payroll detection, and file validation.",
			},
			{
				period: "2018 - 2021",
				role: "Web Application Development (Higher Degree)",
				company: "IES Camp de Morvedre",
				desc: "Higher education in professional web development, agile methodologies, and database management.",
			},
			{
				period: "2018",
				role: "Support Technician (Internship)",
				company: "Servinco",
				desc: "Server and equipment maintenance. Technical assistance providing remote support and telematics.",
			},
			{
				period: "2016 - 2018",
				role: "Microcomputer Systems and Networks",
				company: "IES Camp de Morvedre",
				desc: "General training in microcomputer systems, hardware, and local networks.",
			},
		]}
	/>

	<Skills 
		title="SKILLS & EXPERTISE"
		intro="As a young and proactive developer, I combine my problem-solving instinct with an insatiable desire to keep growing. I excel at solving architectural puzzles and bringing ideas from different perspectives, always striving for excellence and clean code."
		legendText="Areas of deep expertise"
		techStackTitle="Tech Stack"
		techStackDesc="Main languages, frameworks, and tools."
		techStack={[
			{ name: "Laravel" },
			{ name: "PHP" },
			{ name: "Java" },
			{ name: "Spring Boot" },
			{ name: "SQL" },
			{ name: "Vue.js" },
			{ name: "Nuxt.js" },
			{ name: "jQuery" },
			{ name: "JS" },
			{ name: "HTML" },
			{ name: "CSS" },
			{ name: "Git" },
			{ name: "Docker" },
			{ name: "Jira" },
			{ name: "Copilot" },
			{ name: "GPT-codex" },
			{ name: "REST API", isExpert: true },
			{ name: "CMS (Prestashop, Wordpress)", isExpert: true }
		]}
		knowledgeTitle="Knowledge & Methodologies"
		knowledgeDesc="Complementary and transversal skills."
		knowledge={[
			{ name: "English (C1)", isExpert: true },
			{ name: "Web Design", isExpert: true },
			{ name: "SCRUM & Kanban", isExpert: true },
			{ name: "Clean Code", isExpert: true },
			{ name: "Artificial Intelligence (AI)", isExpert: true },
			{ name: "Cybersecurity" },
			{ name: "Server Deployment" },
			{ name: "SEO" },
			{ name: "Digital Marketing" },
			{ name: "Social Media" }
		]}
	/>
</Layout>
