---
import Layout from "../layouts/Layout.astro";
import BackgroundEffects from "../components/BackgroundEffects.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import ContactMe from "../components/ContactMe.astro";
import Timeline from "../components/Timeline.astro";
import Skills from "../components/Skills.astro";
---

<Layout currentLanguage="en">
	<BackgroundEffects />

	<Hero
		tag="PORTFOLIO 2026 — ALPHA V.0.9"
		title="GONZALO"
		titleSuffix="FS"
		description="Full-Stack Engineer with 5+ years of experience."
	/>

	<Marquee items={["Laravel", "Vue.js", "PHP", "JavaScript", "Nuxt.js", "Astro", "Docker", "Git", "MySQL"]} />

	<ContactMe
		title="Let's connect"
		description="With 5+ years of experience, I deeply understand the core of software engineering and problem-solving. I can take full ownership of a problem, developing and deploying production-ready solutions. Today, as an AI-augmented Full-Stack Engineer, I work as the orchestrator and reviewer of AI agents, ensuring high-quality secure code and accelerating end-to-end delivery."
		photoAlt="Gonzalo Fontana Santibáñez"
		contactDescription="I'm currently open to new opportunities. Whether you have a question, a project in mind, or just want to say hi, I'll try my best to get back to you!"
		ctaText="Say Hello"
		email="contact@gonzalofs.com"
		lang="en"
		cvLabel="View CV"
	/>

	<Skills 
		title="SKILLS"
		legendText="Areas of deep expertise"
		techStackTitle="Tech Stack"
		techStackDesc="Main languages, frameworks, and tools."
		techStackSubcategories={[
			{
				title: "Backend",
				skills: [
					{ name: "PHP", isExpert: true },
					{ name: "Laravel", isExpert: true },
					{ name: "Eloquent ORM", isExpert: true },
					{ name: "MySQL / MariaDB", isExpert: true },
					{ name: "Livewire" },
					{ name: "RESTful APIs", isExpert: true },
				]
			},
			{
				title: "Frontend",
				skills: [
					{ name: "JavaScript", isExpert: true },
					{ name: "Vue.js / Nuxt.js", isExpert: true },
					{ name: "Astro" },
					{ name: "Inertia.js" },
					{ name: "Tailwind CSS" },
					{ name: "HTML5 / CSS3", isExpert: true },
					{ name: "jQuery", isExpert: true }
				]
			},
			{
				title: "AI",
				skills: [
					{ name: "LLM Orchestration", isExpert: true },
					{ name: "MCPs & AI Skills", isExpert: true },
					{ name: "GitHub Copilot"},
					{ name: "Antigravity" },
					{ name: "Cursor" },
					{ name: "OpenCode" },
					{ name: "Codex" },
				]
			},
			{
				title: "Tools",
				skills: [
					{ name: "Git / GitHub / Bitbucket", isExpert: true },
					{ name: "Docker" },
					{ name: "Jira", isExpert: true },
					{ name: "HubSpot" },
					{ name: "CMS (PrestaShop, WordPress)" }
				]
			}
		]}
		knowledgeTitle="Other Knowledge"
		knowledgeDesc="Complementary and transversal skills."
		knowledgeSubcategories={[
			{
				title: "Methodologies",
				skills: [
					{ name: "Agile (Scrum / Kanban)", isExpert: true },
					{ name: "Clean Code / SOLID", isExpert: true },
					{ name: "Object-Oriented Programming", isExpert: true },
					{ name: "Spec-Driven Development", isExpert: true },
					{ name: "Domain-Driven Design" },
					{ name: "Test-Driven Development" }
				]
			},
			{
				title: "Infrastructure",
				skills: [
					{ name: "Web Hosting" },
					{ name: "DNS & Domain Management" },
					{ name: "Cybersecurity Fundamentals" }
				]
			},
			{
				title: "Web Design",
				skills: [
					{ name: "UI/UX Design", isExpert: true },
					{ name: "Digital Marketing" },
					{ name: "SEO" }
				]
			},
			{
				title: "Languages",
				skills: [
					{ name: "Spanish (Native)", isExpert: true },
					{ name: "English (C1)", isExpert: true }
				]
			}
		]}
	/>
	
	<Timeline
		title="EXPERIENCE & EDUCATION"
		items={[
			{
				period: "2026",
				role: "AI Certifications",
				company: "Anthropic & OpenAI",
				desc: "AI Fluency: Framework & Foundations Certification by Anthropic. AI Agents and Workflows Certification by OpenAI.",
			},
			{
				period: "2025 - 2026 (Present)",
				role: "AI Integration Lead",
				company: "tugesto (VISMA group)",
				desc: "I led the integration of AI tools and agents into the company's products and workflows. Responsible for the development and deployment of custom AI skills, and the SDD methodology for agentic workflows.",
			},
			{
				period: "2024 - 2025",
				role: "Product Owner",
				company: "tugesto (VISMA group)",
				desc: "I joined the CTO in tech meetings to explain our architecture to VISMA executives, supporting the company's acquisition. As a full-stack engineer, I worked in +13 projects and managed 4 as its product owner, taking full ownership of them and shipping solutions on a continuous integration workflow.",
			},
			{
				period: "2022 - 2024",
				role: "Onboarding Lead",
				company: "tugesto",
				desc: "Led technical onboarding for +25 new hires, scaling the team from 12 to 30 developers, setting up clean code standards and SOLID principles across the department. While I still shipped features as a developer.",
			},
			{
				period: "2021 - 2022",
				role: "Full-Stack Developer",
				company: "tugesto",
				desc: "I developed features for the SaaS, fixed bugs, improved backend code for scalable solutions and worked on frontend alongside UI/UX and Marketing teams",
			},
			{
				period: "2018 - 2021",
				role: "Web Application Development (HND)",
				company: "IES Camp de Morvedre",
				desc: "Higher Vocational Training in professional web development, agile methodologies, and databases.",
			},
			{
				period: "2018",
				role: "IT Technician",
				company: "Servinco",
				desc: "Maintained servers and hardware infrastructure. Provided remote technical support and IT troubleshooting.",
			},
			{
				period: "2016 - 2018",
				role: "Microcomputer Systems and Networks",
				company: "IES Camp de Morvedre",
				desc: "Vocational Training in microcomputer systems, hardware, and local networks.",
			},
		]}
	/>

</Layout>
