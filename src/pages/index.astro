---
import Layout from "../layouts/Layout.astro";
import BackgroundEffects from "../components/BackgroundEffects.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import ContactMe from "../components/ContactMe.astro";
import Timeline from "../components/Timeline.astro";
import Skills from "../components/Skills.astro";
import Achievements from "../components/Achievements.astro";
---

<Layout currentLanguage="en">
	<BackgroundEffects />

	<Hero
		tag="PORTFOLIO 2026 — ALPHA V.0.10"
		title="GONZALO"
		titleSuffix="FS"
		description="Full-Stack Engineer with 5+ years of experience."
	/>

	<Marquee items={["Laravel", "Vue.js", "PHP", "JavaScript", "Nuxt.js", "Astro", "Docker", "Git", "MySQL"]} />

	<ContactMe
		title="Let's connect"
		intro="Hello! I'm Gonzalo, a Full-Stack Engineer based in Valencia, Spain."
		description="With over 5 years of experience building end-to-end web applications. I thrive in high-autonomy environments where I can take complete ownership of features from concept to production. My primary stack is Laravel and Vue, but as an AI-augmented engineer with strong fundamentals, I can adapt quickly to whatever tech stack the project demands."
		photoAlt="Gonzalo Fontana Santibáñez"
		contactDescription="I'm currently open to new opportunities. Whether you have a question, a project in mind, or just want to say hi, contact me and I'll get back to you!"
		ctaText="Say Hello!"
		email="contact@gonzalofs.com"
		lang="en"
		cvLabel="View CV"
	/>

	<Skills 
		title="SKILLS"
		legendText="Areas of deep expertise"
		techStackTitle="Tech Stack"
		techStackDesc="Main languages, frameworks, and technologies."
		techStackSubcategories={[
			{
				title: "Backend",
				skills: [
					{ name: "Laravel", isExpert: true },
					{ name: "PHP", isExpert: true },
					{ name: "RESTful APIs", isExpert: true },
					{ name: "Eloquent ORM", isExpert: true },
					{ name: "MySQL", isExpert: true },
					{ name: "MariaDB", isExpert: true },
					{ name: "Livewire" }
				]
			},
			{
				title: "Frontend",
				skills: [
					{ name: "Vue.js", isExpert: true },
					{ name: "JavaScript", isExpert: true },
					{ name: "Nuxt.js", isExpert: true },
					{ name: "Astro" },
					{ name: "Inertia.js" },
					{ name: "Tailwind CSS" },
					{ name: "Vuetify" },
					{ name: "HTML5", isExpert: true },
					{ name: "CSS3", isExpert: true },
					{ name: "jQuery", isExpert: true }
				]
			},
			{
				title: "AI",
				skills: [
					{ name: "Cursor" },
					{ name: "GitHub Copilot" },
					{ name: "OpenCode" },
					{ name: "Antigravity" },
					{ name: "Codex" },
					{ name: "LLM Orchestration & Routing", isExpert: true },
					{ name: "MCPs & AI Skills", isExpert: true }
				]
			},
			{
				title: "Testing & Security",
				skills: [
					{ name: "PHPUnit", isExpert: true },
					{ name: "AI-Driven Test Automation" },
					{ name: "Snyk" },
					{ name: "Aikido" },
					{ name: "Cybersecurity" },
					{ name: "OWASP Top 10" }
				]
			},
			{
				title: "DevOps",
				skills: [
					{ name: "Git", isExpert: true },
					{ name: "CI/CD with GitHub Actions" },
					{ name: "Docker" },
					{ name: "Sentry" },
					{ name: "DNS & Domain Management" }
				]
			}
		]}
		knowledgeTitle="Other Knowledge"
		knowledgeDesc="Complementary and transversal skills."
		knowledgeSubcategories={[
			{
				title: "Methodologies",
				skills: [
					{ name: "Agile (Scrum & Kanban)", isExpert: true },
					{ name: "Clean Code", isExpert: true },
					{ name: "SOLID", isExpert: true },
					{ name: "Object-Oriented Programming", isExpert: true },
					{ name: "Domain-Driven Design" },
					{ name: "Spec-Driven Development (SDD)", isExpert: true }
				]
			},
			{
				title: "Tools",
				skills: [
					{ name: "Jira", isExpert: true },
					{ name: "Figma" },
					{ name: "VS Code" },
					{ name: "HubSpot" },
					{ name: "WordPress" },
					{ name: "PrestaShop" }
				]
			},
			{
				title: "Languages",
				skills: [
					{ name: "English (Advanced - C1)", isExpert: true },
					{ name: "Spanish (Native)", isExpert: true }
				]
			}
		]}
	/>
	
	<Timeline
		title="EXPERIENCE & EDUCATION"
		items={[
			{
				period: "2026",
				role: "AI Certifications",
				company: "Anthropic & OpenAI",
				desc: "AI Fluency: Framework & Foundations Certification by Anthropic. AI Agents and Workflows Certification by OpenAI.",
			},
			{
				period: "2025 - 2026 (Present)",
				role: "AI Integration Lead",
				company: "tugesto (VISMA group)",
				desc: "I led the integration of AI tools and agents into the company's products and workflows. Responsible for the development and deployment of custom AI skills, and the SDD methodology for agentic workflows.",
			},
			{
				period: "2024 - 2025",
				role: "Product Owner",
				company: "tugesto (VISMA group)",
				desc: "I joined the CTO in tech meetings to explain our architecture to VISMA executives, supporting the company's acquisition. As a full-stack engineer, I worked in +13 projects and managed 4 as its product owner, taking full ownership of them and shipping solutions on a continuous integration workflow.",
			},
			{
				period: "2022 - 2024",
				role: "Onboarding Lead",
				company: "tugesto",
				desc: "Led technical onboarding for +25 new hires, helping scale the engineering team, setting up clean code standards and SOLID principles across the department. While I still shipped features as a developer.",
			},
			{
				period: "2021 - 2022",
				role: "Full-Stack Developer",
				company: "tugesto",
				desc: "I developed features for the SaaS, fixed bugs, improved backend code for scalable solutions and worked on frontend alongside UI/UX and Marketing teams",
			},
			{
				period: "2018 - 2021",
				role: "Web Application Development (HND)",
				company: "IES Camp de Morvedre",
				desc: "Higher Vocational Training in professional web development, agile methodologies, and databases.",
			},
			{
				period: "2018",
				role: "IT Technician",
				company: "Servinco",
				desc: "Maintained servers and hardware infrastructure. Provided remote technical support and IT troubleshooting.",
			},
			{
				period: "2016 - 2018",
				role: "Microcomputer Systems and Networks",
				company: "IES Camp de Morvedre",
				desc: "Vocational Training in microcomputer systems, hardware, and local networks.",
			},
		]}
	/>

	<Achievements
		title="ACHIEVEMENTS"
		stats={[
			{ value: "+25", label: "Developers onboarded" },
			{ value: "+13", label: "Projects delivered" },
			{ value: "4", label: "Projects as Product Owner" },
			{ value: "+40%", label: "Coding speed with AI" },
			{ value: "-50%", label: "Security risks reduced" }
		]}
		achievements={[
			{
				title: "Onboarding & Team Scaling",
				company: "tugesto · 2022 - 2024",
				description: "Led technical onboarding for +25 hires, setting clean-code and SOLID standards across the department.",
				icon: "users"
			},
			{
				title: "Product Ownership",
				company: "tugesto · 2024 - 2025",
				description: "Delivered +13 projects and took full ownership of 4 of them — private APIs and the public website — building the original Vue.js solution alongside UI/UX and Marketing.",
				icon: "briefcase"
			},
			{
				title: "AI Integration Leadership",
				company: "tugesto · 2025 - Present",
				description: "Drove the team's shift to AI tooling with Spec-Driven Development, custom Skills and MCPs, accelerating coding speed by an estimated 40%.",
				icon: "cpu"
			},
			{
				title: "Legacy Modernization",
				company: "tugesto · 2021 - 2025",
				description: "Migrated a legacy PHP project to Laravel 10 and rebuilt the pricing configurator from scratch, improving performance and reducing security risks by 50%.",
				icon: "refresh"
			},
			{
				title: "Acquisition by VISMA",
				company: "tugesto · 2024 - 2025",
				description: "Partnered with the CTO in technical meetings in English to present our architecture to VISMA executives, backing the company's acquisition.",
				icon: "building"
			},
			{
				title: "AI Certifications",
				company: "OpenAI & Anthropic · 2026",
				description: "Earned the AI Fluency (Anthropic) and AI Agents & Workflows (OpenAI) certifications, formalizing the AI methodology now used by the team.",
				icon: "award"
			}
		]}
	/>

</Layout>
