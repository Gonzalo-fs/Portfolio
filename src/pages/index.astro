---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<!-- Cursor Aura Effect -->
	<div id="aura-fast" class="aura-orb layer-1"></div>
	<div id="aura-medium" class="aura-orb layer-2"></div>
	<div id="aura-slow" class="aura-orb layer-3"></div>

	<!-- Custom Cursor -->
	<div id="custom-cursor" class="custom-cursor"></div>

	<div class="background-fx">
		<div class="orb orb-1"></div>
		<div class="orb orb-2"></div>
		<div class="orb orb-3"></div>
	</div>

	<section class="hero">
		<div class="hero-tag">PORTFOLIO 2026 — ALPHA V.0.1</div>
		<h1 class="big-name">GONZALO<span class="name-suffix">FS</span></h1>
		<p class="hero-desc">
			Desarrollador Web Full Stack con más de 4 años de experiencia creando soluciones digitales escalables con código limpio y diseños intuitivos.
		</p>
	</section>

	<div class="marquee-container">
		<div class="marquee-content">
        <span class="marquee-item">• Laravel •</span>
        <span class="marquee-item">• Nuxt.js •</span>
        <span class="marquee-item">• PHP •</span>
        <span class="marquee-item">• Vue.js •</span>
        <span class="marquee-item">• Java •</span>
        <span class="marquee-item">• JQuery •</span>
        <span class="marquee-item">• SQL •</span>
        <span class="marquee-item">• Git •</span>
        <span class="marquee-item">• Docker •</span>
		</div>
	</div>

	<section class="content-section">
		<h2 class="section-title">EXPERIENCIA & EDUCACIÓN</h2>
		
		<div class="timeline">
			<div class="timeline-item">
				<div class="timeline-marker"></div>
				<div class="timeline-content">
					<div class="timeline-period">2022 - Presente</div>
					<h3 class="timeline-title">Desarrollador Full Stack</h3>
					<p class="timeline-company">Freelance</p>
					<p class="timeline-desc">Desarrollo de aplicaciones web escalables con Laravel, Vue.js y Nuxt.js. Implementación de APIs REST y bases de datos MySQL/PostgreSQL.</p>
				</div>
			</div>

			<div class="timeline-item">
				<div class="timeline-marker"></div>
				<div class="timeline-content">
					<div class="timeline-period">2021 - 2022</div>
					<h3 class="timeline-title">Desarrollador Web</h3>
					<p class="timeline-company">Empresa Tech</p>
					<p class="timeline-desc">Desarrollo frontend con Vue.js y JavaScript. Mantenimiento y optimización de aplicaciones web existentes.</p>
				</div>
			</div>

			<div class="timeline-item">
				<div class="timeline-marker"></div>
				<div class="timeline-content">
					<div class="timeline-period">2020 - 2021</div>
					<h3 class="timeline-title">Junior Developer</h3>
					<p class="timeline-company">StartUp Digital</p>
					<p class="timeline-desc">Primeras experiencias en desarrollo web con HTML, CSS y JavaScript. Contribución a proyectos pequeños y medianos.</p>
				</div>
			</div>

			<div class="timeline-item">
				<div class="timeline-marker"></div>
				<div class="timeline-content">
					<div class="timeline-period">2019 - 2020</div>
					<h3 class="timeline-title">Ingeniería en Informática</h3>
					<p class="timeline-company">Universidad</p>
					<p class="timeline-desc">Formación superior en programación, bases de datos, y desarrollo de software. Especialización en desarrollo web.</p>
				</div>
			</div>
		</div>
	</section>

</Layout>

<style>

	/* --- 1. CUSTOM CURSOR --- */
	body {
		cursor: none;
	}

	.custom-cursor {
		position: fixed;
		width: 20px;
		height: 20px;
		background: white;
		border-radius: 50%;
		pointer-events: none;
		z-index: 10000;
		mix-blend-mode: multiply;
		box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
		transform: translate(-50%, -50%);
	}

	/* --- 2. CURSOR AURA EFFECT --- */
	.aura-orb {
		position: fixed;
		top: 0;
		left: 0;
		pointer-events: none;
		border-radius: 50%;
		transform: translate(-50%, -50%);
		mix-blend-mode: screen;
		filter: blur(60px) brightness(1.5) contrast(1.2);
		animation: pulse 6s infinite alternate;
		z-index: 0;
	}

	.layer-1 {
		width: 300px;
		height: 300px;
		background: radial-gradient(circle, #003ada 0%, #051021 40%, transparent 70%);
	}

	.layer-2 {
		width: 200px;
		height: 200px;
		background: radial-gradient(circle, #0044ff 0%, #051021 40%, transparent 70%);
	}

	.layer-3 {
		width: 120px;
		height: 120px;
		background: radial-gradient(circle, #0044ff 0%, #051021 40%, transparent 70%);
	}

	@keyframes pulse {
		0% { transform: translate(-50%, -50%) scale(1); opacity: 0.6; }
		100% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.9; }
	}

	/* --- 2. BACKGROUND ANIMADO --- */
	.background-fx {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		z-index: -1;
		background: radial-gradient(circle at 10% 10%, var(--bg-gradient-1), transparent 40%),
					radial-gradient(circle at 90% 90%, #051021, transparent 40%),
					#02040a;
	}

	.orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.4;
		animation: float 10s infinite ease-in-out alternate;
	}

	.orb-1 {
		width: 300px;
		height: 300px;
		background: var(--bg-gradient-2);
		top: 20%;
		left: -10%;
	}

	.orb-2 {
		width: 400px;
		height: 400px;
		background: #001a4d;
		bottom: 10%;
		right: -10%;
		animation: float 10s infinite ease-in-out alternate -5s;
	}

	.orb-3 {
		width: 250px;
		height: 250px;
		background: #0044ff;
		top: -100px;
		right: -100px;
		animation: float 10s infinite ease-in-out alternate -2.5s;
	}

	@keyframes float {
		0% {
			transform: translate(0, 0) scale(1);
			opacity: 0.4;
			filter: blur(80px) brightness(0.8);
		}
		100% {
			transform: translate(30px, 50px) scale(1.1);
			opacity: 0.6;
			filter: blur(80px) brightness(1);
		}
	}

	/* --- 3. GLASSMORPHISM --- */
	.glass-panel {
		background: var(--glass-bg);
		backdrop-filter: blur(var(--glass-blur));
		-webkit-backdrop-filter: blur(var(--glass-blur));
		border: 1px solid var(--glass-border);
		border-radius: 20px;
		box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
	}

	/* --- 4. HERO SECTION --- */
	.hero {
		height: 90vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		position: relative;
		padding: 2rem;
		text-align: center;
	}

	.hero-tag {
		font-size: 0.9rem;
		color: var(--accent);
		margin-bottom: 1rem;
		font-weight: 600;
		opacity: 0;
		animation: fadeIn 1s ease forwards 0.5s;
	}

	.big-name {
		font-size: 24vw;
		line-height: 1;
		background: linear-gradient(180deg, #fff 0%, rgba(255, 255, 255, 0.5) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		opacity: 0;
		transform: translateY(50px);
		animation: slideUpTitle 1.2s cubic-bezier(0.2, 1, 0.3, 1) forwards;
	}

	.name-suffix {
		font-size: 0.25em;
		vertical-align: top;
		position: relative;
		top: 0.15em;
		margin-left: 0.05em;
		opacity: 0.8;
		background: white;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-desc {
		margin-top: 2rem;
		max-width: 400px;
		color: var(--text-muted);
		font-size: 1.1rem;
		opacity: 0;
		animation: fadeIn 1s ease forwards 0.8s;
	}

	@keyframes slideUpTitle {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fadeIn {
		to {
			opacity: 1;
		}
	}

	/* --- 5. MARQUEE --- */
	.marquee-container {
		width: 100%;
		overflow: hidden;
		padding: 3rem 0;
		background: linear-gradient(90deg, transparent, rgba(0, 68, 255, 0.1), transparent);
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		display: flex;
		position: relative;
		z-index: 2;
	}

	.marquee-content {
		display: flex;
		gap: 4rem;
		white-space: nowrap;
		animation: scrollText 20s linear infinite;
	}

	.marquee-item {
		font-family: 'Anton', sans-serif;
		font-size: 3rem;
		color: rgba(255, 255, 255, 0.1);
		-webkit-text-stroke: 1px rgba(255, 255, 255, 0.3);
	}

	@keyframes scrollText {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	/* --- 6. PROYECTOS --- */
	.content-section {
		padding: 4rem 1.5rem;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}

	.section-title {
		font-size: 2rem;
		margin-bottom: 3rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.section-title::after {
		content: '';
		height: 1px;
		flex-grow: 1;
		background: linear-gradient(90deg, var(--accent), transparent);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.project-card {
		padding: 2rem;
		transition: transform 0.3s ease, border-color 0.3s ease;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: 350px;
		position: relative;
		overflow: hidden;
	}

	.project-card:hover {
		transform: translateY(-5px);
		border-color: var(--accent);
	}

	.project-visual {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 0%, rgba(94, 158, 255, 0.1), transparent 70%);
		z-index: -1;
		transition: opacity 0.3s;
	}

	.project-cat {
		font-size: 0.8rem;
		text-transform: uppercase;
		color: var(--accent);
		letter-spacing: 2px;
		margin-bottom: 0.5rem;
	}

	.project-title {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.project-desc {
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	/* --- 7. TIMELINE --- */
	.timeline {
		position: relative;
		padding: 2rem 0;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		width: 2px;
		height: 100%;
		background: linear-gradient(180deg, var(--accent), transparent);
	}

	.timeline-item {
		margin-bottom: 4rem;
		display: flex;
		position: relative;
	}

	.timeline-item:nth-child(odd) {
		flex-direction: row;
		justify-content: flex-start;
	}

	.timeline-item:nth-child(even) {
		flex-direction: row-reverse;
		justify-content: flex-end;
	}

	.timeline-marker {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--accent);
		border: 3px solid var(--bg-dark);
		top: 20px;
		z-index: 1;
		transition: all 0.3s ease;
	}

	.timeline-item:hover .timeline-marker {
		width: 24px;
		height: 24px;
		top: 16px;
		box-shadow: 0 0 20px rgba(94, 158, 255, 0.6);
	}

	.timeline-content {
		width: 45%;
		padding: 2rem;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(94, 158, 255, 0.2);
		border-radius: 12px;
		backdrop-filter: blur(10px);
		transition: all 0.3s ease;
	}

	.timeline-item:hover .timeline-content {
		border-color: var(--accent);
		background: rgba(94, 158, 255, 0.05);
		transform: translateY(-5px);
	}

	.timeline-period {
		font-size: 0.85rem;
		color: var(--accent);
		font-weight: 600;
		letter-spacing: 1px;
		text-transform: uppercase;
		margin-bottom: 0.5rem;
	}

	.timeline-title {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
		color: var(--text-main);
	}

	.timeline-company {
		font-size: 0.9rem;
		color: var(--accent);
		margin-bottom: 1rem;
		font-weight: 600;
	}

	.timeline-desc {
		font-size: 0.95rem;
		color: var(--text-muted);
		line-height: 1.6;
	}



	/* --- DESKTOP --- */
	@media (min-width: 768px) {
		.projects-grid {
			grid-template-columns: 1fr 1fr;
		}
		.big-name {
			font-size: 15vw;
		}
		.hero {
			padding: 4rem;
		}
		.hero-desc {
			max-width: 600px;
		}
	}

	/* --- MOBILE TIMELINE --- */
	@media (max-width: 767px) {
		.timeline::before {
			left: 20px;
		}

		.timeline-item {
			flex-direction: column !important;
			justify-content: flex-start !important;
			padding-left: 60px;
		}

		.timeline-marker {
			left: 20px;
		}

		.timeline-content {
			width: 100%;
			margin-left: 0;
		}
	}
</style>

<script>
	// Duplicar contenido del marquee para que sea infinito
	const marqueeContent = document.querySelector('.marquee-content');
	if (marqueeContent) {
		const items = marqueeContent.innerHTML;
		marqueeContent.innerHTML = items + items;
	}

	// Custom Cursor
	const customCursor = document.getElementById('custom-cursor');
	let cursorX = 0, cursorY = 0;

	document.addEventListener('mousemove', (e) => {
		cursorX = e.clientX;
		cursorY = e.clientY;
		
		if (customCursor) {
			customCursor.style.left = `${cursorX}px`;
			customCursor.style.top = `${cursorY}px`;
		}
	});

	document.addEventListener('mouseleave', () => {
		if (customCursor) {
			customCursor.style.opacity = '0';
		}
	});

	document.addEventListener('mouseenter', () => {
		if (customCursor) {
			customCursor.style.opacity = '1';
		}
	});

	// Cursor Aura Effect
	function initAuraEffect() {
		const auraFast = document.getElementById('aura-fast');
		const auraMedium = document.getElementById('aura-medium');
		const auraSlow = document.getElementById('aura-slow');

		if (!auraFast || !auraMedium || !auraSlow) return;

		let mouseX = 0, mouseY = 0;

		// POSICIONES E INERCIAS
		let fastX = 0, fastY = 0;
		const fastSpeed = 0.2;

		let mediumX = 0, mediumY = 0;
		const mediumSpeed = 0.06;

		let slowX = 0, slowY = 0;
		const slowSpeed = 0.04;

		document.addEventListener('mousemove', (e) => {
			mouseX = e.clientX;
			mouseY = e.clientY;
		});

		function animate() {
			// Lógica de seguimiento (LERP)
			fastX += (mouseX - fastX) * fastSpeed;
			fastY += (mouseY - fastY) * fastSpeed;
			
			mediumX += (mouseX - mediumX) * mediumSpeed;
			mediumY += (mouseY - mediumY) * mediumSpeed;
			
			slowX += (mouseX - slowX) * slowSpeed;
			slowY += (mouseY - slowY) * slowSpeed;
			
			// Aplicar transformación
			auraFast.style.left = `${fastX}px`;
			auraFast.style.top = `${fastY}px`;
			
			auraMedium.style.left = `${mediumX}px`;
			auraMedium.style.top = `${mediumY}px`;
			
			auraSlow.style.left = `${slowX}px`;
			auraSlow.style.top = `${slowY}px`;
			
			requestAnimationFrame(animate);
		}

		animate();
	}

	// Ejecutar cuando el DOM esté listo
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initAuraEffect);
	} else {
		initAuraEffect();
	}
</script>
