---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="background-fx">
		<div class="orb orb-1"></div>
		<div class="orb orb-2"></div>
		<div class="orb orb-3"></div>
	</div>

	<section class="hero">
		<div class="hero-tag">PORTFOLIO 2026 — ALPHA V.0.1</div>
		<h1 class="big-name">GONZALO<span class="name-suffix">FS</span></h1>
		<p class="hero-desc">
			Desarrollador Web Full Stack con más de 4 años de experiencia creando soluciones digitales escalables con código limpio y diseños intuitivos.
		</p>
	</section>

	<div class="marquee-container">
		<div class="marquee-content">
        <span class="marquee-item">• Laravel •</span>
        <span class="marquee-item">• Nuxt.js •</span>
        <span class="marquee-item">• PHP •</span>
        <span class="marquee-item">• Vue.js •</span>
        <span class="marquee-item">• Java •</span>
        <span class="marquee-item">• JQuery •</span>
        <span class="marquee-item">• SQL •</span>
        <span class="marquee-item">• Git •</span>
        <span class="marquee-item">• Docker •</span>
		</div>
	</div>



</Layout>

<style>

	/* --- 2. BACKGROUND ANIMADO --- */
	.background-fx {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		z-index: -1;
		background: radial-gradient(circle at 10% 10%, var(--bg-gradient-1), transparent 40%),
					radial-gradient(circle at 90% 90%, #051021, transparent 40%),
					#02040a;
	}

	.orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.4;
		animation: float 10s infinite ease-in-out alternate;
	}

	.orb-1 {
		width: 300px;
		height: 300px;
		background: var(--bg-gradient-2);
		top: 20%;
		left: -10%;
	}

	.orb-2 {
		width: 400px;
		height: 400px;
		background: #001a4d;
		bottom: 10%;
		right: -10%;
		animation: float 10s infinite ease-in-out alternate -5s;
	}

	.orb-3 {
		width: 250px;
		height: 250px;
		background: #0044ff;
		top: -100px;
		right: -100px;
		animation: float 10s infinite ease-in-out alternate -2.5s;
	}

	@keyframes float {
		0% {
			transform: translate(0, 0) scale(1);
			opacity: 0.4;
			filter: blur(80px) brightness(0.8);
		}
		100% {
			transform: translate(30px, 50px) scale(1.1);
			opacity: 0.6;
			filter: blur(80px) brightness(1);
		}
	}

	/* --- 3. GLASSMORPHISM --- */
	.glass-panel {
		background: var(--glass-bg);
		backdrop-filter: blur(var(--glass-blur));
		-webkit-backdrop-filter: blur(var(--glass-blur));
		border: 1px solid var(--glass-border);
		border-radius: 20px;
		box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
	}

	/* --- 4. HERO SECTION --- */
	.hero {
		height: 90vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		position: relative;
		padding: 2rem;
		text-align: center;
	}

	.hero-tag {
		font-size: 0.9rem;
		color: var(--accent);
		margin-bottom: 1rem;
		font-weight: 600;
		opacity: 0;
		animation: fadeIn 1s ease forwards 0.5s;
	}

	.big-name {
		font-size: 24vw;
		line-height: 1;
		background: linear-gradient(180deg, #fff 0%, rgba(255, 255, 255, 0.5) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		opacity: 0;
		transform: translateY(50px);
		animation: slideUpTitle 1.2s cubic-bezier(0.2, 1, 0.3, 1) forwards;
	}

	.name-suffix {
		font-size: 0.25em;
		vertical-align: top;
		position: relative;
		top: 0.15em;
		margin-left: 0.05em;
		opacity: 0.8;
		background: white;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-desc {
		margin-top: 2rem;
		max-width: 400px;
		color: var(--text-muted);
		font-size: 1.1rem;
		opacity: 0;
		animation: fadeIn 1s ease forwards 0.8s;
	}

	@keyframes slideUpTitle {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fadeIn {
		to {
			opacity: 1;
		}
	}

	/* --- 5. MARQUEE --- */
	.marquee-container {
		width: 100%;
		overflow: hidden;
		padding: 3rem 0;
		background: linear-gradient(90deg, transparent, rgba(0, 68, 255, 0.1), transparent);
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		display: flex;
		position: relative;
		z-index: 2;
	}

	.marquee-content {
		display: flex;
		gap: 4rem;
		white-space: nowrap;
		animation: scrollText 20s linear infinite;
	}

	.marquee-item {
		font-family: 'Anton', sans-serif;
		font-size: 3rem;
		color: rgba(255, 255, 255, 0.1);
		-webkit-text-stroke: 1px rgba(255, 255, 255, 0.3);
	}

	@keyframes scrollText {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	/* --- 6. PROYECTOS --- */
	.content-section {
		padding: 4rem 1.5rem;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}

	.section-title {
		font-size: 2rem;
		margin-bottom: 3rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.section-title::after {
		content: '';
		height: 1px;
		flex-grow: 1;
		background: linear-gradient(90deg, var(--accent), transparent);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.project-card {
		padding: 2rem;
		transition: transform 0.3s ease, border-color 0.3s ease;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: 350px;
		position: relative;
		overflow: hidden;
	}

	.project-card:hover {
		transform: translateY(-5px);
		border-color: var(--accent);
	}

	.project-visual {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 0%, rgba(94, 158, 255, 0.1), transparent 70%);
		z-index: -1;
		transition: opacity 0.3s;
	}

	.project-cat {
		font-size: 0.8rem;
		text-transform: uppercase;
		color: var(--accent);
		letter-spacing: 2px;
		margin-bottom: 0.5rem;
	}

	.project-title {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.project-desc {
		color: var(--text-muted);
		font-size: 0.95rem;
	}



	/* --- DESKTOP --- */
	@media (min-width: 768px) {
		.projects-grid {
			grid-template-columns: 1fr 1fr;
		}
		.big-name {
			font-size: 15vw;
		}
		.hero {
			padding: 4rem;
		}
		.hero-desc {
			max-width: 600px;
		}
	}
</style>

<script>
	// Duplicar contenido del marquee para que sea infinito
	const marqueeContent = document.querySelector('.marquee-content');
	if (marqueeContent) {
		const items = marqueeContent.innerHTML;
		marqueeContent.innerHTML = items + items;
	}
</script>
