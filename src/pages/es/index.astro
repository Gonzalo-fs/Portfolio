			{
				period: "2018 - 2021",
				role: "Desarrollo de Aplicaciones Web (Grado Superior)",
				company: "IES Camp de Morvedre",
				desc: "Formación profesional superior en desarrollo web, metodologías ágiles y bases de datos.",
			},
			{
				period: "2018",
				role: "Técnico Informático",
				company: "Servinco",
				desc: "Mantenimiento de servidores e infraestructura de hardware. Soporte técnico remoto y resolución de incidencias IT.",
			},
			{
				period: "2016 - 2018",
				role: "Sistemas Microinformáticos y Redes",
				company: "IES Camp de Morvedre",
				desc: "Formación profesional en sistemas microinformáticos, hardware y redes locales.",
			},
		]}
