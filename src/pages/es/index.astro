			},
			{
				title: "Diseño Web",
				skills: [
					{ name: "Diseño UI/UX", isExpert: true },
					{ name: "Marketing Digital" },
					{ name: "SEO" }
				]
			},
			{
				title: "Idiomas",
				skills: [
					{ name: "Español (Nativo)", isExpert: true },
					{ name: "Inglés (C1)", isExpert: true }
				]
			}
		]}
	/>

