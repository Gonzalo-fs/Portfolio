---
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { defaultLanguage } from "../i18n";

export interface Props {
	currentLanguage?: "en" | "es";
}

const { currentLanguage = defaultLanguage } = Astro.props;
---

<!doctype html>
<html lang={currentLanguage}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@300;400;600&display=swap"
			rel="stylesheet"
		/>
		<title>GONZALO FS | Web Dev</title>
	</head>
	<body>
		<LanguageSwitcher currentLanguage={currentLanguage} />
		<slot />

		<footer>
			<p>© 2026 Gonzalo Fontana Santibáñez.</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg-dark: #02060f;
		--bg-gradient-1: #0a1529;
		--bg-gradient-2: #0044ff;
		--text-main: #ffffff;
		--text-muted: rgba(255, 255, 255, 0.6);
		--glass-bg: rgba(255, 255, 255, 0.03);
		--glass-border: rgba(255, 255, 255, 0.08);
		--glass-blur: 16px;
		--accent: #5e9eff;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html,
	body {
		width: 100%;
		height: 100%;
	}

	body {
		background-color: var(--bg-dark);
		font-family: "Manrope", sans-serif;
		color: var(--text-main);
		overflow-x: hidden;
		line-height: 1.5;
	}

	h1,
	h2,
	h3 {
		font-family: "Anton", sans-serif;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	footer {
		padding: 4rem;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.8rem;
		position: relative;
		z-index: 2;
	}
</style>
