---
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { defaultLanguage } from "../i18n";

export interface Props {
	currentLanguage?: "en" | "es";
}

const { currentLanguage = defaultLanguage } = Astro.props;
---

<!doctype html>
<html lang={currentLanguage}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@300;400;600&display=swap"
			rel="stylesheet"
		/>
		<title>GONZALO FS | Web Dev</title>
	</head>
	<body>
		<LanguageSwitcher currentLanguage={currentLanguage} />
		<a
			href={currentLanguage === "es" ? "/ES-GonzaloFS.pdf" : "/EN-GonzaloFS.pdf"}
			target="_blank"
			rel="noopener noreferrer"
			class="cv-fab"
			id="cv-fab"
			aria-label={currentLanguage === "es" ? "Ver CV" : "View CV"}
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
				<polyline points="14 2 14 8 20 8"/>
				<line x1="16" y1="13" x2="8" y2="13"/>
				<line x1="16" y1="17" x2="8" y2="17"/>
				<polyline points="10 9 9 9 8 9"/>
			</svg>
			<span>{currentLanguage === "es" ? "Ver CV" : "View CV"}</span>
		</a>
		<slot />

		<footer>
			<p>© 2026 Gonzalo Fontana Santibáñez.</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg-dark: #02060f;
		--bg-gradient-1: #0a1529;
		--bg-gradient-2: #0044ff;
		--text-main: #ffffff;
		--text-muted: rgba(255, 255, 255, 0.6);
		--glass-bg: rgba(255, 255, 255, 0.03);
		--glass-border: rgba(255, 255, 255, 0.08);
		--glass-blur: 16px;
		--accent: #5e9eff;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html,
	body {
		width: 100%;
		height: 100%;
	}

	body {
		background-color: var(--bg-dark);
		font-family: "Manrope", sans-serif;
		color: var(--text-main);
		overflow-x: hidden;
		line-height: 1.5;
	}

	h1,
	h2,
	h3 {
		font-family: "Anton", sans-serif;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	.cv-fab {
		position: fixed;
		top: 20px;
		left: 20px;
		z-index: 1000;
		height: 48px;
		padding: 0 1.25rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		background: rgba(94, 158, 255, 0.1);
		border: 1px solid rgba(94, 158, 255, 0.35);
		border-radius: 12px;
		color: var(--accent);
		backdrop-filter: blur(var(--glass-blur));
		-webkit-backdrop-filter: blur(var(--glass-blur));
		transition: all 0.3s ease;
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.3px;
	}

	.cv-fab:hover {
		background: rgba(94, 158, 255, 0.2);
		border-color: var(--accent);
		transform: translateY(-3px);
		box-shadow: 0 6px 20px rgba(94, 158, 255, 0.25);
	}

	@media (max-width: 768px) {
		.cv-fab {
			top: 10px;
			left: 10px;
			height: 42px;
			padding: 0 1rem;
			font-size: 0.8rem;
		}
	}

	footer {
		padding: 4rem;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.8rem;
		position: relative;
		z-index: 2;
	}
</style>
